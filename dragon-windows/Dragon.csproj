<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Dragon</AssemblyName>
    <RootNamespace>Dragon</RootNamespace>
    <ApplicationIcon>dragon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Version>4.3.0</Version>
    <Product>Dragon</Product>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- 64-bit build: the WebView2 loader is copied next to Dragon.exe instead of being picked at runtime -->
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <ItemGroup>
    <!-- .NET Framework 4.8 ships with Windows 10/11, so the app needs no runtime install; WebView2 is part of Windows too -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
  <ItemGroup>
    <None Include="app\**" CopyToOutputDirectory="PreserveNewest" LinkBase="app" />
    <EmbeddedResource Include="dragon.ico" LogicalName="dragon.ico" />
  </ItemGroup>
  <!-- keep a copy of the 64-bit WebView2 loader right next to Dragon.exe -->
  <Target Name="CopyLoaderNextToExe" AfterTargets="Build">
    <Copy SourceFiles="$(OutDir)runtimes\win-x64\native\WebView2Loader.dll" DestinationFolder="$(OutDir)" />
  </Target>
</Project>
